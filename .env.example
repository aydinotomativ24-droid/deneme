# Stripe — clé secrète (mode test : sk_test_...). Sans cette variable, le paiement
# fonctionne en "mode démo" et redirige directement vers la page de confirmation.
STRIPE_SECRET_KEY=

# URL publique du site (utilisée pour les redirections Stripe en production).
# En local, laissez vide : l'origine de la requête est utilisée automatiquement.
NEXT_PUBLIC_SITE_URL=

# Mot de passe de l'espace administrateur (/admin) pour consulter les commandes.
# Par défaut "airfroid-admin" si non défini — À CHANGER en production.
ADMIN_PASSWORD=
